getgenv().YARHMFUNCTIONS = {}

getgenv().YARHMFUNCTIONS.executeNoveFling = function(t)
    if not Alive(t) or not Alive(lp) or isFlingingNow then return end
    local mh = HRP()
    local th = HRP(t.Character)
    local thum = HUM(t.Character)
    if not mh or not th then return end
    
    isFlingingNow = true
    local oldCFrame = mh.CFrame
    
    local bzv = Instance.new("BodyVelocity")
    bzv.Velocity = Vector3.new(0, 0, 0)
    bzv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bzv.Parent = mh
    
    local bav = Instance.new("BodyAngularVelocity")
    bav.AngularVelocity = Vector3.new(0, 250000, 0)
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.P = 40000
    bav.Parent = mh
    
    mh.CanCollide = false
    
    local flingLoop
    local duration = 0
    
    flingLoop = RS.Heartbeat:Connect(function(dt)
        duration = duration + dt
        
        local isFarAway = false
        if th and th.Parent then
            if th.Position.Y < -180 then
                isFarAway = true
            end
        end

        if duration > 3.5 or not Alive(t) or not Alive(lp) or not th.Parent or isFarAway then
            flingLoop:Disconnect()
            pcall(function() bzv:Destroy() end)
            pcall(function() bav:Destroy() end)
            pcall(function()
                mh.AssemblyLinearVelocity = Vector3.zero
                mh.AssemblyAngularVelocity = Vector3.zero
                mh.CFrame = oldCFrame 
            end)
            task.wait(0.1)
            isFlingingNow = false
            return
        end
        
        local targetPos = th.Position
        if thum and thum.FloorMaterial == Enum.Material.Air then
            targetPos = th.Position + Vector3.new(0, thum.TargetPoint.Y * 0.1, 0)
        end

        local angleX = math.sin(tick() * 45) * 6
        local angleZ = math.cos(tick() * 45) * 6
        
        mh.CFrame = CFrame.new(targetPos) * CFrame.Angles(angleX, 0, angleZ)
        mh.AssemblyLinearVelocity = Vector3.new(40000, 40000, 40000)
    end)
end

