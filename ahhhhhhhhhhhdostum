-- ==================== ANTIFLING SİSTEMİ ====================
local antiFlingConnections = {}
local antiFlingEnabled = false

local function setupAntiFlingCharacter(character)
    local function disableCollide(part)
        if antiFlingEnabled and part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    for _, part in ipairs(character:GetChildren()) do
        disableCollide(part)
    end
    local childAddedConn = character.ChildAdded:Connect(disableCollide)
    local steppedConn = RS.Stepped:Connect(function()
        if antiFlingEnabled and character:IsDescendantOf(workspace) then
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
    character.Destroying:Connect(function()
        childAddedConn:Disconnect()
        steppedConn:Disconnect()
    end)
end

local function trackAntiFlingPlayer(player)
    if player == lp then return end
    local charAddedConn = player.CharacterAdded:Connect(setupAntiFlingCharacter)
    if player.Character then
        setupAntiFlingCharacter(player.Character)
    end
    antiFlingConnections[player] = charAddedConn
end

local function untrackAntiFlingPlayer(player)
    if antiFlingConnections[player] then
        antiFlingConnections[player]:Disconnect()
        antiFlingConnections[player] = nil
    end
end

local antiFlingPlayerAdded
local antiFlingPlayerRemoving

local function enableAntiFling()
    if antiFlingEnabled then return end
    antiFlingEnabled = true
    for _, player in ipairs(PL:GetPlayers()) do
        trackAntiFlingPlayer(player)
    end
    antiFlingPlayerAdded = PL.PlayerAdded:Connect(trackAntiFlingPlayer)
    antiFlingPlayerRemoving = PL.PlayerRemoving:Connect(untrackAntiFlingPlayer)
end

local function disableAntiFling()
    antiFlingEnabled = false
    for player, conn in pairs(antiFlingConnections) do
        conn:Disconnect()
    end
    antiFlingConnections = {}
    if antiFlingPlayerAdded then antiFlingPlayerAdded:Disconnect() antiFlingPlayerAdded = nil end
    if antiFlingPlayerRemoving then antiFlingPlayerRemoving:Disconnect() antiFlingPlayerRemoving = nil end
end

local function Rol(p)
    if not p or not p.Character then return "M" end
    local function chk(n) n=n:lower()
        if n:find("knife") or n:find("murder") or n:find("blade") then return "K" end
        if n:find("gun") or n:find("sheriff") or n:find("revolver") then return "S" end
    end
    for _,v in ipairs(p.Character:GetChildren()) do if v:IsA("Tool") then local r=chk(v.Name);if r then return r end end end
    local bp=p:FindFirstChildOfClass("Backpack")
    if bp then for _,v in ipairs(bp:GetChildren()) do if v:IsA("Tool") then local r=chk(v.Name);if r then return r end end end end
    return "M"
end

