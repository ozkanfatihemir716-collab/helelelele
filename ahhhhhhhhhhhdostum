local function CreateListGui(name, titleText, color, fillFn, isFling)
    if PGui:FindFirstChild(name) then PGui[name]:Destroy() end
    local G2 = Instance.new("ScreenGui", PGui); G2.Name = name; G2.ResetOnSpawn = false

    local F = Instance.new("Frame", G2)
    F.Size = UDim2.new(0, 240, 0, 360)
    F.Position = UDim2.new(0.5, (name == "PRTP" and 140 or (name == "PRFL" and -380 or -120)), 0.5, -180)
    F.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
    F.Active = true; F.BorderSizePixel = 0
    Instance.new("UICorner", F).CornerRadius = UDim.new(0, 8)
    local fstr = Instance.new("UIStroke", F); fstr.Color = color; fstr.Thickness = 2

    local closeBtn = Instance.new("TextButton", F)
    closeBtn.Size = UDim2.new(0, 26, 0, 26); closeBtn.Position = UDim2.new(1, -32, 0, 8)
    closeBtn.BackgroundColor3 = Color3.fromRGB(230, 50, 50); closeBtn.Text = "✕"; closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.Font = Enum.Font.GothamBold; closeBtn.TextSize = 12
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)
    closeBtn.MouseButton1Click:Connect(function()
        if isFling then stopFling() end
        G2:Destroy()
    end)

    local tl = Instance.new("TextLabel", F)
    tl.Size = UDim2.new(1, -45, 0, 34); tl.Position = UDim2.new(0, 12, 0, 3)
    tl.BackgroundTransparency = 1; tl.Text = titleText; tl.TextColor3 = color
    tl.Font = Enum.Font.GothamBold; tl.TextSize = 13; tl.TextXAlignment = Enum.TextXAlignment.Left

    local activeLabel = nil
    if isFling then
        activeLabel = Instance.new("TextLabel", F)
        activeLabel.Size = UDim2.new(1, -20, 0, 20)
        activeLabel.Position = UDim2.new(0, 10, 0, 38)
        activeLabel.BackgroundTransparency = 1
        activeLabel.Text = T.FlingActive .. "-"
        activeLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
        activeLabel.Font = Enum.Font.GothamBold
        activeLabel.TextSize = 11
        activeLabel.TextXAlignment = Enum.TextXAlignment.Left
    end

    local SC = Instance.new("ScrollingFrame", F)
    SC.Name = "SC"
    SC.Size = UDim2.new(1, -16, 1, isFling and -110 or -60)
    SC.Position = UDim2.new(0, 8, 0, isFling and 65 or 42)
    SC.BackgroundTransparency = 1
    SC.ScrollBarThickness = 3
    SC.ScrollBarImageColor3 = color
    SC.AutomaticCanvasSize = Enum.AutomaticSize.Y
    SC.CanvasSize = UDim2.new(0, 0, 0, 0)
    local sclayout = Instance.new("UIListLayout", SC); sclayout.Padding = UDim.new(0, 5)

    if isFling then
        local stopBtn = Instance.new("TextButton", F)
        stopBtn.Size = UDim2.new(1, -16, 0, 30)
        stopBtn.Position = UDim2.new(0, 8, 1, -38)
        stopBtn.BackgroundColor3 = Color3.fromRGB(160, 45, 45)
        stopBtn.Text = T.StopFling
        stopBtn.TextColor3 = Color3.new(1, 1, 1)
        stopBtn.Font = Enum.Font.GothamBold
        stopBtn.TextSize = 11
        Instance.new("UICorner", stopBtn).CornerRadius = UDim.new(0, 5)
        stopBtn.MouseButton1Click:Connect(function()
            stopFling()
            if activeLabel then activeLabel.Text = T.FlingActive .. "-" end
        end)
    elseif name == "PRSP" then
        local stopBtn = Instance.new("TextButton", F)
        stopBtn.Size = UDim2.new(1, -16, 0, 30)
        stopBtn.Position = UDim2.new(0, 8, 1, -38)
        stopBtn.BackgroundColor3 = Color3.fromRGB(160, 45, 45)
        stopBtn.Text = T.StopSpec
        stopBtn.TextColor3 = Color3.new(1, 1, 1)
        stopBtn.Font = Enum.Font.GothamBold
        stopBtn.TextSize = 11
        Instance.new("UICorner", stopBtn).CornerRadius = UDim.new(0, 5)
        stopBtn.MouseButton1Click:Connect(function()
            spectateActive = false
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
                Camera.CameraSubject = lp.Character.Humanoid
            end
        end)
    end

    local d, i, s, p
    F.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            d = true; s = input.Position; p = F.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then d = false end end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if d and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - s
            F.Position = UDim2.new(p.X.Scale, p.X.Offset + delta.X, p.Y.Scale, p.Y.Offset + delta.Y)
        end
    end)

    task.spawn(function()
        while G2.Parent do
            for _, child in pairs(SC:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            for _, plr in pairs(PL:GetPlayers()) do
                if plr ~= lp and Alive(plr) then
                    local r = Rol(plr)
                    local b = Instance.new("TextButton", SC)
                    b.Size = UDim2.new(1, -4, 0, 34)
                    b.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
                    b.Text = RI[r] .. " " .. plr.Name
                    b.TextColor3 = RR[r]
                    b.Font = Enum.Font.GothamBold
                    b.TextSize = 12
                    b.BorderSizePixel = 0
                    b.TextXAlignment = Enum.TextXAlignment.Center
                    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
                    b.MouseButton1Click:Connect(function()
                        if isFling then
                            if getgenv().YARHMFUNCTIONS.executeNoveFling then
                                getgenv().YARHMFUNCTIONS.executeNoveFling(plr)
                            end
                            if activeLabel then activeLabel.Text = T.FlingActive .. plr.Name end
                        else
                            fillFn(plr)
                            G2:Destroy()
                        end
                    end)
                end
            end
            wait(1)
        end
    end)
    return G2
end

