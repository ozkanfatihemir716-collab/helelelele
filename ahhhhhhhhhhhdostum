local function updateESP()
    for _, p in pairs(PL:GetPlayers()) do
        if p.Character then
            local old = p.Character:FindFirstChild("MESP")
            if old then old:Destroy() end
        end
    end
    for _, v in pairs(workspace:GetDescendants()) do
        local g = v:FindFirstChild("GESP")
        if g then g:Destroy() end
    end

    if not G.ESP then return end

    for _, p in pairs(PL:GetPlayers()) do
        if p ~= lp and p.Character and Alive(p) then
            local ch = p.Character
            local folder = Instance.new("Folder", ch)
            folder.Name = "MESP"

            local role = Rol(p)
            local color = RR[role]

            local hl = Instance.new("Highlight", folder)
            hl.Adornee = ch
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.OutlineTransparency = 0.2
            hl.FillTransparency = 0.5
            hl.FillColor = color
            hl.OutlineColor = color

            local head = ch:FindFirstChild("Head")
            if head then
                local bb = Instance.new("BillboardGui", folder)
                bb.Name = "NameTag"
                bb.Adornee = head
                bb.Size = UDim2.new(4, 0, 1.2, 0)
                bb.StudsOffset = Vector3.new(0, 2.5, 0)
                bb.AlwaysOnTop = true

                local label = Instance.new("TextLabel", bb)
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = p.Name .. " " .. RI[role]
                label.TextColor3 = color
                label.TextStrokeTransparency = 0.3
                label.TextStrokeColor3 = Color3.new(0, 0, 0)
                label.Font = Enum.Font.GothamBold
                label.TextSize = 13
            end
        end
    end

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = v.Name:lower()
            if n:find("coin") or n:find("gold") then
                if not v:FindFirstChild("GESP") then
                    local hl = Instance.new("Highlight", v)
                    hl.Name = "GESP"
                    hl.FillColor = Color3.fromRGB(255, 200, 0)
                    hl.FillTransparency = 0.3
                    hl.OutlineColor = Color3.fromRGB(255, 220, 0)
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
            end
        end
    end
end

RS.Heartbeat:Connect(function(dt)
    timers.esp = timers.esp + dt
    if timers.esp >= 1.0 then
        timers.esp = 0
        updateESP()
    end
end)

RS.RenderStepped:Connect(function()
    if spectateActive and spectateTarget and spectateTarget.Character then
        local h = spectateTarget.Character:FindFirstChildOfClass("Humanoid")
        if h then pcall(function() Camera.CameraSubject = h end) end
    elseif G.Aimlock and not spectateActive then
        if not aimTarget or not Alive(aimTarget) or Rol(aimTarget) ~= "K" then
            local closest = nil
            local minDist = math.huge
            for _, p in pairs(PL:GetPlayers()) do
                if p ~= lp and Alive(p) and Rol(p) == "K" then
                    local hrp = HRP(p.Character)
                    local myHrp = HRP()
                    if hrp and myHrp then
                        local dist = (myHrp.Position - hrp.Position).Magnitude
                        if dist < minDist then minDist = dist; closest = p end
                    end
                end
            end
            aimTarget = closest
        end
        if aimTarget and aimTarget.Character then
            local head = aimTarget.Character:FindFirstChild("Head")
            if head then Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position) end
        end
    else
        aimTarget = nil
    end
end)

RS.Heartbeat:Connect(function(dt)
    if G.Noclip and lp.Character then
        for _, v in ipairs(lp.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end
    end

    if G.AllKill and Alive(lp) and Rol(lp) == "K" then
        timers.kill = timers.kill + dt
        if timers.kill >= 1.0 then
            timers.kill = 0
            local myHRP = HRP()
            if myHRP then
                for _, p in pairs(PL:GetPlayers()) do
                    if p ~= lp and Alive(p) and Rol(p) ~= "K" then
                        local eHRP = HRP(p.Character)
                        if eHRP then eHRP.CFrame = myHRP.CFrame end
                    end
                end
                local knife = lp.Character:FindFirstChild("Knife") or (lp:FindFirstChildOfClass("Backpack") and lp.Backpack:FindFirstChild("Knife"))
                if knife then
                    if knife.Parent ~= lp.Character then knife.Parent = lp.Character end
                    pcall(function() knife:Activate() end)
                end
            end
        end
    end

    if G.Gun and Alive(lp) and Rol(lp) ~= "K" then
        timers.gun = timers.gun + dt
        if timers.gun >= 0.2 then
            timers.gun = 0
            for _, v in pairs(workspace:GetDescendants()) do
                if v.Name == "GunDrop" or v.Name == "RevolverDrop" or (v.Name:lower():find("gun") and v.Parent == workspace) then
                    local tg = v:IsA("BasePart") and v or v:FindFirstChild("Handle")
                    if tg then
                        local mh = HRP()
                        if mh then
                            local old = mh.CFrame
                            mh.CFrame = tg.CFrame
                            task.wait(0.25)
                            mh.CFrame = old
                            break
                        end
                    end
                end
            end
        end
    end
end)

