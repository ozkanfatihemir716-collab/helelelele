    Instance.new("UICorner", statusInd).CornerRadius = UDim.new(1, 0)
    local function updateVisual()
        btn.Text = "  " .. text; btn.TextXAlignment = Enum.TextXAlignment.Left
        if G[propName] then
            btn.TextColor3 = Color3.fromRGB(255, 255, 255); strk.Color = Color3.fromRGB(0, 220, 120); statusInd.BackgroundColor3 = Color3.fromRGB(0, 220, 120)
        else
            btn.TextColor3 = Color3.fromRGB(150, 150, 160); strk.Color = Color3.fromRGB(40, 40, 50); statusInd.BackgroundColor3 = Color3.fromRGB(80, 80, 90)
        end
    end
    btn.MouseButton1Click:Connect(function()
        G[propName] = not G[propName]
        updateVisual()
        if propName == "Aimlock" then aimTarget = nil end
        if propName == "AntiFling" then
            if G.AntiFling then enableAntiFling() else disableAntiFling() end
        end
    end)
    updateVisual()
end

